{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "incremental": false,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "lib": ["es2022", "DOM", "DOM.Iterable"],
        "moduleDetection": "force",
        "noUncheckedIndexedAccess": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler"
    }
}
