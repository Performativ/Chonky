{
    "name": "chonky",
    "version": "2.3.2",
    "description": "A File Browser component for React",
    "type": "module",
    "license": "MIT",
    "main": "dist/index.js",
    "typings": "dist/index.d.ts",
    "files": [
        "dist",
        "src"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "tsup --watch",
        "dev": "vite",
        "build": "tsup",
        "test": "vitest",
        "lint": "eslint src",
        "prepare": "tsup",
        "size": "size-limit"
    },
    "packageManager": "pnpm@10.23.0",
    "peerDependencies": {
        "react": ">=18"
    },
    "prettier": {
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": true,
        "singleQuote": true,
        "useTabs": false,
        "printWidth": 88
    },
    "module": "dist/chonky.esm.js",
    "size-limit": [
        {
            "path": "dist/chonky.cjs.production.min.js",
            "limit": "10 KB"
        },
        {
            "path": "dist/chonky.esm.js",
            "limit": "10 KB"
        }
    ],
    "devDependencies": {
        "@babel/core": "^7.13.10",
        "@eslint/js": "^9.39.1",
        "@size-limit/preset-small-lib": "^4.10.1",
        "@testing-library/react": "^16.3.0",
        "@types/react": "^19.0.1",
        "@types/react-dom": "^19.0.1",
        "@vitejs/plugin-react": "^5.1.0",
        "babel-loader": "^8.2.2",
        "eslint": "^9.39.1",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^16.5.0",
        "husky": "^5.1.3",
        "jiti": "^2.6.1",
        "prettier": "^3.6.2",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "react-is": "^19.0.1",
        "size-limit": "^4.10.1",
        "tslib": "^2.1.0",
        "tsup": "^8.5.0",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.46.3",
        "vite": "^7.2.2",
        "vitest": "^4.0.12"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^5",
        "@reduxjs/toolkit": "^2.10.0",
        "@types/fuzzy-search": "^2.1.0",
        "@types/memoizee": "^0.4.5",
        "@types/node": "^24.9.1",
        "@types/react-redux": "^7.1.34",
        "@types/react-window": "^1.8.2",
        "@types/redux-watch": "^1.1.0",
        "@types/shortid": "^0.0.29",
        "@typescript-eslint/eslint-plugin": "^8.46.3",
        "classnames": "^2.2.6",
        "deepmerge": "^4.2.2",
        "eslint-plugin-react-hooks": "^7.0.1",
        "exact-trie": "^1.0.13",
        "fast-sort": "^2.2.0",
        "filesize": "^6.1.0",
        "fuzzy-search": "^3.2.1",
        "hotkeys-js": "^3.8.3",
        "lucide-react": "^0.552.0",
        "react-dnd": "16.0.1",
        "react-dnd-html5-backend": "16.0.1",
        "react-intl": "^7.1.14",
        "react-jss": "^10.5.1",
        "react-redux": "^9.2.0",
        "react-virtualized-auto-sizer": "^1.0.5",
        "react-window": "^1.8.6",
        "redux": "^5.0.1",
        "redux-watch": "^1.2.0",
        "shortid": "^2.2.16",
        "styled-components": "^5.3.0"
    },
    "homepage": "https://chonky.io/",
    "author": {
        "name": "Timur Kuzhagaliyev",
        "email": "tim.kuzh@gmail.com",
        "url": "https://foxypanda.me/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TimboKZ/Chonky.git"
    },
    "bugs": {
        "url": "https://github.com/TimboKZ/Chonky/issues"
    },
    "keywords": [
        "file",
        "chonky",
        "file-dialog",
        "file-browser",
        "react-component"
    ]
}
